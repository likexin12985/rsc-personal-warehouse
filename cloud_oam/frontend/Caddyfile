www.{$APP_DOMAIN:localhost} {
    redir https://{$APP_DOMAIN:localhost}{uri} permanent
}

{$APP_DOMAIN:localhost} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    redir /xx /xx/ 308

    handle_path /xx/* {
        root * /srv/warehouse
        header Cache-Control "no-cache"
        @warehouse_assets path /assets/* /sw.js /manifest.webmanifest
        handle @warehouse_assets {
            file_server
        }
        handle {
            try_files {path} /index.html
            file_server
        }
    }

    handle {
        root * /srv/public
        header Cache-Control "no-cache"
        @public_assets path /assets/* /brand/* /sw.js /manifest.webmanifest /knowledge-catalog.json
        handle @public_assets {
            file_server
        }
        handle {
            try_files {path} /index.html
            file_server
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
        -Server
    }
}
