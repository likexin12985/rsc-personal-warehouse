<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cn.rsc.oam-edge-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>__RSC_EDGE_RUNTIME_ROOT__/cloud_oam/edge_sync/run_launchd_sync.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__RSC_EDGE_RUNTIME_ROOT__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__RSC_EDGE_USER_HOME__</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>__RSC_EDGE_LOG_DIR__/oam-edge-sync-launchd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__RSC_EDGE_LOG_DIR__/oam-edge-sync-launchd.stderr.log</string>
</dict>
</plist>
