<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rsc.oam-edge-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-N</string>
        <string>-L</string>
        <string>127.0.0.1:18001:127.0.0.1:18000</string>
        <string>-i</string>
        <string>/Users/replace-with-local-user/.ssh/rsc-edge-tunnel_ed25519</string>
        <string>-o</string>
        <string>BatchMode=yes</string>
        <string>-o</string>
        <string>IdentitiesOnly=yes</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>-o</string>
        <string>ServerAliveInterval=30</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>edge-tunnel@replace-with-edge-host</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>15</integer>
    <key>StandardOutPath</key>
    <string>/Users/replace-with-local-user/Library/Logs/RSC/oam-edge-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/replace-with-local-user/Library/Logs/RSC/oam-edge-tunnel.error.log</string>
</dict>
</plist>
