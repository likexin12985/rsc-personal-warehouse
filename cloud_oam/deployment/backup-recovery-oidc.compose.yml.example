# Draft only. Target-host UID/GID collision and ownership are still unverified.
# Independent read-only recovery role, never writer/reader/API credentials.
services:
  joint-backup-recovery:
    image: ${RSC_API_IMAGE:-star-oam-api:0.9.0}
    profiles: [ops]
    restart: "no"
    init: true
    user: "23211:23221"
    group_add: ["23220"]
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    pids_limit: 64
    mem_limit: 512m
    working_dir: /opt/rsc-backup-worker
    entrypoint: [python, /opt/rsc-backup-worker/deadline_runner.py]
    command: [--help]
    environment:
      PYTHONPATH: /app:/opt/rsc-release-guards:/opt/rsc-backup-worker
      ALIBABA_CLOUD_CREDENTIALS_FILE: /dev/null
      ALIBABA_CLOUD_ECS_METADATA_DISABLED: "true"
      RSC_BACKUP_RECOVERY_ACCOUNT_ID: "1934673129483837"
      RSC_BACKUP_RECOVERY_ROLE_ARN: acs:ram::1934673129483837:role/rsc-pilot-backup-recovery
      RSC_BACKUP_RECOVERY_PROVIDER_ARN: ${RSC_BACKUP_RECOVERY_PROVIDER_ARN:-}
      RSC_BACKUP_RECOVERY_SESSION_NAME: ${RSC_BACKUP_RECOVERY_SESSION_NAME:-}
      RSC_BACKUP_RECOVERY_TOKEN_FILE: /run/rsc-backup-recovery/oidc.jwt
      RSC_BACKUP_RECOVERY_WRITER: openbao_agent_template_v1
      RSC_BACKUP_RECOVERY_PROJECTOR_UID: "23210"
      RSC_BACKUP_RECOVERY_SHARED_GID: "23220"
      RSC_BACKUP_RECOVERY_WORKER_UID: "23211"
      RSC_BACKUP_RECOVERY_WORKER_GID: "23221"
    volumes:
      - type: bind
        source: ./deployment/backup-worker
        target: /opt/rsc-backup-worker
        read_only: true
        bind: {create_host_path: false}
      - type: bind
        source: ${RSC_BACKUP_RECOVERY_HOST_DIRECTORY:-/run/rsc-backup-recovery-not-configured}
        target: /run/rsc-backup-recovery
        read_only: true
        bind: {create_host_path: false}
      - type: bind
        source: ${RSC_BACKUP_RECOVERY_JOURNAL_DIRECTORY:-/run/rsc-recovery-journal-not-configured}
        target: /recovery-journal
        read_only: true
        bind: {create_host_path: false}
      - type: bind
        source: ${RSC_BACKUP_RECOVERY_OUTPUT_DIRECTORY:-/run/rsc-recovery-output-not-configured}
        target: /recovery-output
        read_only: false
        bind: {create_host_path: false}
      - type: bind
        source: ./scripts/pilot_release.py
        target: /opt/rsc-release-guards/pilot_release.py
        read_only: true
        bind: {create_host_path: false}
      - type: bind
        source: ./scripts/pilot_preflight.py
        target: /opt/rsc-release-guards/pilot_preflight.py
        read_only: true
        bind: {create_host_path: false}
      - type: bind
        source: ./scripts/pilot_network_preflight.py
        target: /opt/rsc-release-guards/pilot_network_preflight.py
        read_only: true
        bind: {create_host_path: false}
      - type: bind
        source: ./scripts/oss_bucket_preflight.py
        target: /opt/rsc-release-guards/oss_bucket_preflight.py
        read_only: true
        bind: {create_host_path: false}
      - type: bind
        source: ./scripts/backup_bucket_preflight.py
        target: /opt/rsc-release-guards/backup_bucket_preflight.py
        read_only: true
        bind: {create_host_path: false}
    tmpfs:
      - /tmp:size=16m,mode=1777
    networks: [backup_egress]
