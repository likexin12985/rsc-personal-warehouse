# Public deployment coordinates only. Nothing here creates a role or Agent.
# Use the one same-account RAM OIDC provider for the reviewed OpenBao issuer;
# this writer's role, subject, audience and token directory must be independent.
RSC_BACKUP_WRITER_PROVIDER_ARN=
RSC_BACKUP_WRITER_SESSION_NAME=
RSC_BACKUP_WRITER_HOST_DIRECTORY=/run/rsc-backup-writer-not-configured
# Explicit controlled handoff from reader UID 23207 to writer UID 23209:
# no root fallback and no shared reader/API credential. Input file 0600,
# directories 0700 owned by archive worker; input bind RO, state bind RW.
RSC_BACKUP_ARCHIVE_INPUT_DIRECTORY=/run/rsc-archive-input-not-configured
RSC_BACKUP_ARCHIVE_STATE_DIRECTORY=/run/rsc-archive-state-not-configured
# No automatic invocation. After real role/bucket/RO-mount acceptance:
# docker compose ... run --rm --no-deps joint-backup-archive --seconds 900 \
#   --temp-parent /archive-state -- python /opt/rsc-backup-worker/archive_joint.py \
#   --archive --bundle /archive-input/verified-joint.tar \
#   --attempt-dir /archive-state/<new-unique-attempt> --maximum-bytes 1073741824
# Following any timeout/unknown, inspect that exact journal and use ONLY:
# ... --reconcile --attempt-dir /archive-state/<same-attempt> --maximum-bytes 1073741824
# Never restart --archive with a new attempt to evade an unresolved write.
# Destination is fixed in code: rsc-pilot-backups-1934673129483837, joint/v1/.
# RSC_OSS_BACKUP_BUCKET remains the attachment SOURCE bucket, unchanged.
