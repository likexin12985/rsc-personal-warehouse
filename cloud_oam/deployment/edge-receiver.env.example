# Dedicated staging-only database role. It must not have DDL privileges or any
# user/inventory business-table access. The reviewed grant script limits it to
# the isolated snapshot mirror tables plus append-only transport audit evidence.
RSC_EDGE_DATABASE_ROLE=edge_inbox
RSC_EDGE_DATABASE_URL=postgresql+psycopg://edge_inbox:replace-me@db:5432/star_oam

# Separate from JWT/login secrets and at least 32 random characters.
RSC_EDGE_SYNC_SECRET=replace-with-a-separate-32-character-random-secret

# Exact X-RSC-Edge-Source identifiers, comma separated. No wildcard.
RSC_EDGE_ALLOWED_SOURCES=authorized-admin-mac

# Optional capture receipts. Empty keeps the feature disabled. Set only after
# deploying migration 0114 and reviewing the exact source binding. This is the
# version of RSC_EDGE_SYNC_SECRET, not another secret; change it on key rotation.
RSC_EDGE_CONTROL_CAPTURE_KEY_ID=

# Optional material capture ingress/status. Empty is disabled. Requires 0116 and
# a separately registered exact source/key fingerprint and validity interval.
# It uses RSC_EDGE_SYNC_SECRET with a material-specific fingerprint domain.
RSC_EDGE_MATERIAL_CAPTURE_KEY_ID=
