# Non-secret candidates only; actual identities, collisions and RO mounts await
# target-host review. Role: rsc-pilot-backup-recovery, separate subject/audience.
# Grants: four exact backup bucket setting GETs + joint/v1/* GetObject and
# GetObjectVersion; NO PutObject/DeleteObject/ListBucket or application data role.
RSC_BACKUP_RECOVERY_PROVIDER_ARN=
RSC_BACKUP_RECOVERY_SESSION_NAME=
RSC_BACKUP_RECOVERY_HOST_DIRECTORY=/run/rsc-backup-recovery-not-configured
RSC_BACKUP_RECOVERY_JOURNAL_DIRECTORY=/run/rsc-recovery-journal-not-configured
RSC_BACKUP_RECOVERY_OUTPUT_DIRECTORY=/run/rsc-recovery-output-not-configured
# Journal must be a controlled 0600 copy owned by recovery worker, private0700
# directory, digest independently taken from the approved VERIFIED archive receipt.
# Do not copy writer token or give recovery long-lived writer permissions.
# Under reviewed overlay after actual identity/bucket acceptance:
# docker compose ... run --rm --no-deps joint-backup-recovery --seconds 60 \
#   -- python /opt/rsc-release-guards/backup_bucket_preflight.py --inspect
# docker compose ... run --rm --no-deps joint-backup-recovery --seconds 900 \
#   --temp-parent /recovery-output -- python /opt/rsc-backup-worker/recover_joint.py \
#   --download --journal-directory /recovery-journal --journal-sha256 <approved-sha256> \
#   --destination /recovery-output/<new-unique-attempt> --maximum-bytes 1073741824
# Partial output is preserved after uncertainty; never automatically rerun over
# it. No database import, OSS upload, Bao recovery or production restore occurs.
