# Requires Docker Compose >= 2.24.4 for exact security-list replacement.
# Review and copy into the candidate's deployment directory before use.
# The host directory must already be a verified private tmpfs projection.
# This file does not start an issuer, project tokens or grant cloud permissions.
services:
  api:
    # Explicit non-root numeric identity, verified against the live container.
    user: ${RSC_API_UID:?reviewed API uid required}:${RSC_API_GID:?reviewed API gid required}
    cap_drop: !override [ALL]
    cap_add: !override []
    privileged: false
    security_opt: !override ["no-new-privileges:true"]
    group_add:
      - ${RSC_OSS_OIDC_SHARED_GID:?reviewed projection read group required}
    environment:
      OAM_FILE_STORAGE_CREDENTIAL_MODE: oidc_role_arn
      OAM_FILE_STORAGE_OIDC_TOKEN_FILE: /run/rsc-identity/files/oidc.jwt
      # Deployment verifier metadata, not application settings or secret values.
      RSC_OSS_OIDC_PROJECTOR_UID: ${RSC_OSS_OIDC_PROJECTOR_UID:?reviewed independent projector uid required}
      RSC_OSS_OIDC_SHARED_GID: ${RSC_OSS_OIDC_SHARED_GID:?reviewed projection read group required}
      # Public issuer contract for the combined OSS/PNVS candidate. Actual
      # JWT/JWKS and RAM trust are verified separately, never inferred here.
      RSC_OIDC_EXPECTED_ACCOUNT_ID: ${RSC_OIDC_EXPECTED_ACCOUNT_ID:?reviewed RAM account required}
      RSC_OIDC_ISSUER_URL: ${RSC_OIDC_ISSUER_URL:?reviewed OpenBao issuer required}
      RSC_OSS_OIDC_SUBJECT: ${RSC_OSS_OIDC_SUBJECT:?reviewed OSS entity UUID required}
      RSC_OSS_OIDC_AUDIENCE: ${RSC_OSS_OIDC_AUDIENCE:?reviewed OSS audience required}
    volumes:
      - type: bind
        source: ${RSC_OSS_OIDC_HOST_DIR:?reviewed tmpfs projection required}
        target: /run/rsc-identity/files
        read_only: true
        bind:
          create_host_path: false
