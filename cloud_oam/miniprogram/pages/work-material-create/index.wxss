.form-section { margin-top: 0; }
.search-row { display: flex; gap: 12rpx; }
.search-input { flex: 1; min-width: 0; }
.search-button { flex: 0 0 130rpx; padding: 0; }
.material-results { height: 360rpx; margin-top: 14rpx; background: #fff; border: 1rpx solid #dfe4e7; border-radius: 10rpx; }
.material-result { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; padding: 16rpx 20rpx; border-bottom: 1rpx solid #e8ecee; }
.result-code, .result-name { display: block; }
.result-code { font-size: 23rpx; font-weight: 700; }
.result-name { margin-top: 5rpx; color: #6e7880; font-size: 22rpx; }
.add-text { color: #d64d16; font-size: 24rpx; font-weight: 650; }
.item-code { font-size: 24rpx; font-weight: 700; }
.item-name { display: block; margin-top: 8rpx; font-weight: 600; }
.remove { color: #b43b2d; font-size: 23rpx; }
.item-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 20rpx; }
