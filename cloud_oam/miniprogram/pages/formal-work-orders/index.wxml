<view class="page">
  <view class="page-title">我的工单物料</view>
  <view class="page-subtitle">{{message}}</view>
  <view wx:if="{{loading}}" class="loading">正在读取</view>
  <button wx:if="{{state === 'error'}}" class="button" bindtap="refresh">重新读取</button>
  <view wx:if="{{pendingRequests.length || pendingMessage || recoveryMessage}}" class="card">
    <view class="order-no">本人待确认请求</view>
    <view class="muted">工单改派、关闭或不在当前列表时，仍可读取此前提交的结果。</view>
    <view wx:if="{{pendingMessage}}">{{pendingMessage}}</view>
    <view wx:for="{{pendingRequests}}" wx:for-item="pending" wx:key="id" class="draft-row">
      <view>{{pending.label}}</view>
      <button size="mini" disabled="{{busy || loading}}" loading="{{busy}}" data-id="{{pending.id}}" bindtap="recoverPendingRequest">读取原请求结果</button>
      <button wx:if="{{canSeal && pending.sealable}}" size="mini" disabled="{{busy || loading}}" data-id="{{pending.id}}" bindtap="sealPendingRequest">结束未执行请求</button>
    </view>
    <view wx:if="{{recoveryMessage}}">{{recoveryMessage}}</view>
  </view>
  <block wx:if="{{state === 'ready' && !workOrder}}">
    <view class="card search-row">
      <input placeholder="搜索工单编号" value="{{search}}" maxlength="100" bindinput="onSearchInput" bindconfirm="search" />
      <button size="mini" bindtap="search">搜索</button>
    </view>
    <view wx:for="{{orders}}" wx:key="work_order_id" class="card order-card" data-id="{{item.work_order_id}}" bindtap="openOrder">
      <view class="row between"><text class="order-no">{{item.work_order_no}}</text><text>{{item.statusLabel}}</text></view>
      <view class="muted">{{item.freshnessLabel}}</view>
      <view class="muted">来源更新：{{item.source_updated_at}}</view>
      <view class="muted">最近同步：{{item.synced_at}}</view>
      <view class="detail-link">查看工单物料 ›</view>
    </view>
    <view class="row between pager">
      <button size="mini" disabled="{{!hasPrevious}}" bindtap="previousPage">上一页</button>
      <text>第 {{pageNumber}} 页</text>
      <button size="mini" disabled="{{!hasNext}}" bindtap="nextPage">下一页</button>
    </view>
  </block>
  <block wx:if="{{state === 'ready' && workOrder}}">
    <button size="mini" bindtap="backToOrders">选择其他工单</button>
    <view class="card">
      <view class="order-no">{{workOrder.work_order_no}}</view>
      <view>{{workOrder.statusLabel}} · {{workOrder.freshnessLabel}}</view>
      <view class="muted">{{locationName}}</view>
      <view class="muted">来源更新：{{workOrder.source_updated_at}}</view>
      <view class="muted">最近同步：{{workOrder.synced_at}}</view>
    </view>
    <view class="card">
      <view class="order-no">结束前物料检查</view>
      <button size="mini" disabled="{{busy || loading}}" bindtap="checkCompletion">检查占用、回收与退回</button>
      <view wx:if="{{completionMessage}}">{{completionMessage}}</view>
      <block wx:if="{{completion}}">
        <view class="muted">检查时间：{{completion.checkedAt}}</view>
        <view wx:for="{{completion.blockers}}" wx:for-item="reason" wx:key="code">{{reason.label}}</view>
        <view wx:for="{{completion.issues}}" wx:for-item="issue" wx:key="id" class="draft-row">
          <view class="order-no">{{issue.label}}</view>
          <view>{{issue.material_name}} · {{issue.sku_code}}</view>
          <view>{{issue.conditionLabel}}<text wx:if="{{issue.lot_no}}"> · 批次 {{issue.lot_no}}</text></view>
          <view>{{issue.quantity}} {{issue.base_unit}}</view>
          <view wx:if="{{issue.operation_no}}" class="muted">原操作：{{issue.operation_no}}</view>
          <view wx:for="{{issue.serials}}" wx:for-item="sn" wx:key="serial_id">SN：{{sn.serial_no}}</view>
          <view wx:if="{{issue.kind === 'pending_return'}}" class="muted">需通过退回单及接收确认解除保管责任。</view>
          <view wx:if="{{issue.kind === 'unpaired_serial_consumption'}}" class="muted">需核对本次是否以换代修，以及拆回件的处理情况。</view>
        </view>
      </block>
    </view>
    <view wx:if="{{confirming}}" class="card confirmation-card">
      <view class="order-no">{{reviewTitle}}</view>
      <view>工单：{{reviewWorkOrderNo}}</view>
      <view class="muted">{{reviewDescription || (operationKind === 'replace' ? '确认后将整批登记实际消耗、拆回入库和新旧 SN 配对。请逐行核对两侧物料。' : operationKind === 'occupy' ? '确认后，本批物料将转为此工单占用。' : operationKind === 'consume' ? '请确认已实际使用，本次将扣减工单占用和个人仓实物库存。' : '确认后，此工单的未用物料将转回本人可用库存。')}}</view>
      <view wx:for="{{reviewRows}}" wx:for-item="row" wx:key="lineNo" class="draft-row">
        <view wx:if="{{row.side}}" class="order-no">{{row.side}}<text wx:if="{{row.basisLineNo}}"> · 对应投入第 {{row.basisLineNo}} 行</text></view>
        <view wx:if="{{row.basisName}}">投入依据：{{row.basisName}} · {{row.basisSku}}</view>
        <view wx:if="{{row.basisName}}">投入成色：{{row.basisCondition}}<text wx:if="{{row.basisLot}}"> · 批次 {{row.basisLot}}</text></view>
        <view>{{row.materialName}} · {{row.sku}}</view>
        <view>{{row.condition}}<text wx:if="{{row.lot}}"> · 批次 {{row.lot}}</text></view>
        <view class="quantity">本次数量：{{row.quantity}} {{row.unit}}</view>
        <view wx:for="{{row.serialNumbers}}" wx:for-item="sn" wx:key="*this" class="serial">SN：{{sn}}</view>
      </view>
      <view wx:for="{{reviewPairs}}" wx:for-item="pair" wx:key="pairNo" class="draft-row">
        <view>配对 {{pair.pairNo}}</view><view class="serial">投入 SN：{{pair.installed}}</view><view class="serial">拆回 SN：{{pair.removed}}</view>
      </view>
      <button type="primary" bindtap="confirmSubmission">{{reviewTitle}}</button>
      <button bindtap="cancelSubmission">返回修改</button>
    </view>
    <view wx:if="{{canDraft && !confirming}}" class="card">
      <view class="order-no">准备本次工单物料</view>
      <view class="muted">选择操作和物料后核验整批。预检通过时库存尚未变动。</view>
      <view class="operation-choices">
        <button size="mini" type="{{operationKind === 'occupy' ? 'primary' : 'default'}}" disabled="{{busy}}" data-kind="occupy" bindtap="chooseOperation">投入占用</button>
        <button size="mini" type="{{operationKind === 'consume' ? 'primary' : 'default'}}" disabled="{{busy}}" data-kind="consume" bindtap="chooseOperation">实际消耗</button>
        <button size="mini" type="{{operationKind === 'release' ? 'primary' : 'default'}}" disabled="{{busy}}" data-kind="release" bindtap="chooseOperation">释放未用物料</button>
        <button size="mini" type="{{operationKind === 'replace' ? 'primary' : 'default'}}" disabled="{{busy}}" data-kind="replace" bindtap="chooseOperation">成对消耗与回收</button>
      </view>
    </view>
    <view wx:if="{{!items.length && !confirming}}" class="card">暂无可展示的可用物料或本工单剩余占用。</view>
    <view wx:if="{{!confirming}}" wx:for="{{items}}" wx:key="stock_account_id" class="card material-card">
      <view class="order-no">{{item.material_name}}</view>
      <view>{{item.sku_code}} · {{item.conditionLabel}}</view>
      <view wx:if="{{item.lot_no}}" class="muted">批次：{{item.lot_no}}</view>
      <view class="quantity">{{item.quantityLabel}}：{{item.selectable_quantity}} {{item.base_unit}}</view>
      <view wx:for="{{item.serials}}" wx:for-item="serial" wx:key="serial_id" class="serial">SN：{{serial.serial_no}}</view>
      <button wx:if="{{canDraft && ((operationKind === 'occupy' && item.availability_bucket === 'available') || (operationKind !== 'occupy' && item.availability_bucket === 'reserved'))}}" size="mini" disabled="{{busy}}" data-id="{{item.stock_account_id}}" bindtap="addMaterial">加入本次物料</button>
    </view>
    <view wx:if="{{canDraft && draftRows.length && !confirming}}" class="card">
      <view class="order-no">本次物料草稿</view>
      <view class="muted">{{operationKind === 'replace' ? '成对消耗与回收' : operationKind === 'occupy' ? '投入占用' : operationKind === 'consume' ? '实际消耗' : '释放未用物料'}} · 离开页面后扫码草稿清空</view>
      <view wx:for="{{draftRows}}" wx:for-item="row" wx:key="id" class="draft-row">
        <view>{{row.materialName}} · {{row.sku}}</view>
        <view class="muted">本次最多 {{row.maximum}} {{row.unit}}</view>
        <input wx:if="{{!row.tracked}}" class="quantity-input" type="digit" value="{{row.quantity}}" maxlength="19" disabled="{{busy}}" placeholder="填写本次数量" data-id="{{row.id}}" bindinput="editQuantity" />
        <block wx:else>
          <view class="scan-buttons">
            <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-code="sku_code" bindtap="scanMaterialCode">{{row.skuCaptured ? '重扫 SKU' : '扫描 SKU'}}</button>
            <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-code="serial_no" bindtap="scanMaterialCode">{{row.snCaptured ? '重扫 SN' : '扫描 SN'}}</button>
            <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-code="qr_code" bindtap="scanMaterialCode">{{row.qrCaptured ? '重扫二维码' : '扫描二维码'}}</button>
          </view>
          <button size="mini" disabled="{{busy || !row.skuCaptured || !row.snCaptured || !row.qrCaptured}}" data-id="{{row.id}}" bindtap="collectScanned">加入此件物料</button>
          <view class="muted">已采集 {{row.serials.length}} 件，待整批校验</view>
          <view wx:for="{{row.serials}}" wx:for-item="sn" wx:key="id" class="serial">
            <text>{{sn.number}}</text><button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-serial="{{sn.id}}" bindtap="removeScanned">移除此件</button>
          </view>
        </block>
        <button wx:if="{{operationKind === 'replace'}}" size="mini" disabled="{{busy}}" data-id="{{row.id}}" bindtap="addRemoved">登记对应的拆回件</button>
        <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" bindtap="removeMaterial">移除该物料</button>
      </view>
      <block wx:if="{{operationKind === 'replace'}}">
        <view class="order-no">本次拆回件</view>
        <view class="muted">每条投入都须登记拆回件。数量件填写实际数量；有 SN 的拆回件逐件登记，选择对应的投入 SN。</view>
        <view wx:for="{{removedRows}}" wx:for-item="removed" wx:key="id" class="draft-row removed-row">
          <view>对应投入第 {{removed.basisLineNo}} 行：{{removed.basisName}} · {{removed.basisSku}}</view>
          <view class="scan-buttons">
            <button size="mini" disabled="{{busy}}" type="{{removed.condition === 'used' ? 'primary' : 'default'}}" data-id="{{removed.id}}" data-field="condition" data-value="used" bindtap="editRemoved">旧件</button>
            <button size="mini" disabled="{{busy}}" type="{{removed.condition === 'damaged' ? 'primary' : 'default'}}" data-id="{{removed.id}}" data-field="condition" data-value="damaged" bindtap="editRemoved">坏件</button>
          </view>
          <view class="scan-buttons">
            <button size="mini" disabled="{{busy}}" data-id="{{removed.id}}" data-code="sku_code" bindtap="scanRemoved">{{removed.skuCaptured ? '重扫拆回 SKU' : '扫描拆回 SKU'}}</button>
            <button size="mini" disabled="{{busy}}" data-id="{{removed.id}}" data-code="serial_no" bindtap="scanRemoved">{{removed.snCaptured ? '重扫拆回 SN' : '有 SN：扫描 SN'}}</button>
            <button size="mini" disabled="{{busy}}" data-id="{{removed.id}}" data-code="qr_code" bindtap="scanRemoved">{{removed.qrCaptured ? '重扫拆回二维码' : '有 SN：扫描二维码'}}</button>
          </view>
          <input class="quantity-input" disabled="{{busy}}" value="{{removed.lot}}" maxlength="160" placeholder="批次物料填写批次号；已登记 SN 可识别批次" data-id="{{removed.id}}" data-field="lot_no" bindinput="editRemoved" />
          <button size="mini" disabled="{{busy || !removed.condition || !removed.skuCaptured}}" data-id="{{removed.id}}" bindtap="inspectRemoved">识别并核验拆回件</button>
          <block wx:if="{{removed.registrationAvailable}}">
            <view class="muted">三码未匹配已登记 SN。请核对标签；登记只建立身份，不增加库存。</view>
            <button size="mini" disabled="{{busy || !removed.condition || !removed.skuCaptured || !removed.snCaptured || !removed.qrCaptured}}" data-id="{{removed.id}}" bindtap="registerRemoved">核验并登记拆回 SN</button>
          </block>
          <block wx:if="{{removed.identified}}">
            <view>{{removed.materialName}} · {{removed.sku}}</view>
            <view wx:if="{{removed.identifiedLot}}">批次：{{removed.identifiedLot}}</view>
            <block wx:if="{{removed.tracked}}">
              <view class="serial">拆回 SN：{{removed.serialNo}} · 1 {{removed.unit}}</view>
              <picker disabled="{{busy}}" range="{{removed.pairChoices}}" value="{{removed.pairIndex}}" data-id="{{removed.id}}" bindchange="chooseInstalled">
                <view class="pair-picker">{{removed.pairChoices[removed.pairIndex]}} ▾</view>
              </picker>
            </block>
            <input wx:else class="quantity-input" disabled="{{busy}}" type="digit" value="{{removed.quantity}}" maxlength="19" placeholder="填写实际拆回数量" data-id="{{removed.id}}" data-field="quantity" bindinput="editRemoved" />
          </block>
          <button size="mini" disabled="{{busy}}" data-id="{{removed.id}}" bindtap="removeRemoved">移除这条拆回件</button>
        </view>
      </block>
      <button disabled="{{busy}}" loading="{{busy}}" bindtap="previewMaterials">核验整批物料</button>
      <button type="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="submitMaterials">{{operationKind === 'replace' ? '成对消耗与回收' : operationKind === 'occupy' ? '投入占用' : operationKind === 'consume' ? '实际消耗' : '释放未用物料'}}：核验并确认</button>
    </view>
    <view wx:if="{{previewMessage}}" class="card">{{previewMessage}}</view>
  </block>
</view>
