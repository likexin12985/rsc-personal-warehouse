page {
  background:#f5f7f2;
  color:#173832;
}

.knowledge-page {
  padding:56rpx 36rpx 32rpx;
}

.eyebrow {
  font-size:19rpx;
  letter-spacing:3rpx;
  color:#597568;
}

.hero-title {
  font-size:52rpx;
  font-weight:600;
  line-height:1.5;
  margin:26rpx 0;
}

.hero-title text {
  display:block;
}

.intro {
  font-size:26rpx;
  line-height:1.8;
  color:#5c7266;
}

.search {
  display:flex;
  align-items:center;
  background:#fff;
  border:1rpx solid #bacabd;
  border-radius:16rpx;
  padding:16rpx;
  margin:40rpx 0 48rpx;
}

.search input {
  flex:1;
  min-width:0;
  font-size:25rpx;
  padding:0 12rpx;
}

.search>text {
  font-size:25rpx;
  background:#214f43;
  color:#fff;
  border-radius:10rpx;
  padding:16rpx 22rpx;
}

.section-heading {
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-top:1rpx solid #dce4da;
  padding-top:36rpx;
  font-size:34rpx;
  font-weight:600;
}

.category {
  font-size:24rpx;
  font-weight:400;
  background:#fff;
  border:1rpx solid #cfdbd0;
  border-radius:10rpx;
  padding:16rpx;
  max-width:280rpx;
}

.empty {
  text-align:center;
  padding:54rpx 22rpx;
  border:1rpx dashed #c2d0c3;
  border-radius:16rpx;
  background:#eef2eb;
  color:#607769;
  font-size:25rpx;
  line-height:1.8;
  margin-top:32rpx;
}

.empty-mark {
  font-size:44rpx;
  color:#38624d;
}

.empty-title {
  font-size:32rpx;
  color:#254b3e;
  font-weight:600;
  margin:16rpx;
}

.count {
  font-size:24rpx;
  color:#617568;
  margin:28rpx 0;
}

.card {
  padding:32rpx;
  background:#fff;
  border:1rpx solid #d7e0d4;
  border-radius:16rpx;
  margin:20rpx 0;
  font-size:26rpx;
  overflow-wrap:anywhere;
}

.card-heading {
  display:flex;
  justify-content:space-between;
  gap:20rpx;
  font-size:22rpx;
}

.tag {
  color:#406847;
  background:#edf3e9;
  padding:8rpx;
}

.code {
  color:#627367;
}

.part-name {
  font-size:32rpx;
  font-weight:600;
  margin:26rpx 0;
}

.label {
  font-size:23rpx;
  color:#6e7f73;
  margin:18rpx 0 6rpx;
}

.note {
  white-space:pre-wrap;
}

.reference {
  border-top:1rpx solid #e6ebe2;
  padding-top:22rpx;
  margin-top:28rpx;
  font-size:22rpx;
  color:#657c6d;
}

.pagination {
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:26rpx;
}

.pagination button,.empty button,.source button {
  font-size:24rpx;
  color:#214f43;
  background:#fff;
}

.source {
  font-size:24rpx;
  line-height:1.9;
  color:#627367;
  margin:40rpx 0;
}

.source button {
  margin:20rpx 0;
  width:220rpx;
}

.footer {
  font-size:22rpx;
  color:#6b7e70;
  border-top:1rpx solid #dce4da;
  padding-top:32rpx;
}
