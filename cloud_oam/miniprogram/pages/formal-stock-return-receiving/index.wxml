<view class="page">
  <view class="title">区域仓退回收货</view>
  <view class="muted">{{message}}</view>
  <button loading="{{loading}}" disabled="{{loading}}" bindtap="refresh">刷新原包裹和验收记录</button>
  <block wx:if="{{ready && !detail}}">
    <view wx:if="{{!packages.length}}" class="card muted">本页没有当前由本人接收的退回包裹。</view>
    <view wx:for="{{packages}}" wx:key="id" class="card">
      <block wx:if="{{item.verified}}">
        <view class="heading">{{item.number}}</view><view>退回单：{{item.returnNo}}</view>
        <view>接收仓：{{item.target}}</view><view class="tracking">{{item.carrier}} · {{item.trackingNo}}</view>
        <view>实际交运：{{item.shippedAt}}</view><view>{{item.lineCount}} 条原包裹明细</view>
        <button data-id="{{item.id}}" bindtap="openPackage">查看本包验收进度</button>
      </block>
      <view wx:else class="notice">{{item.message}}</view>
    </view>
    <button wx:if="{{next}}" bindtap="nextPage">下一页包裹</button>
  </block>
  <block wx:if="{{ready && detail}}">
    <view class="card"><view class="heading">{{package.number}}</view><view>退回单：{{package.returnNo}}</view>
      <view>接收仓：{{package.target}}</view><view class="tracking">{{package.carrier}} · {{package.trackingNo}}</view>
      <view>实际交运：{{package.shippedAt}}</view></view>
    <view class="card"><view class="heading">累计验收进度</view>
      <view wx:for="{{progress}}" wx:key="id" wx:for-item="line" class="row">
        <view class="heading">{{line.materialName}}</view><view class="muted">{{line.sku}} · {{line.condition}} · {{line.lot}}</view>
        <view>原发出：{{line.outboundNo}}</view><view>本包发运 {{line.shipped}} {{line.unit}}</view>
        <view>累计接受 {{line.accepted}} · 拒收 {{line.rejected}} {{line.unit}}</view>
        <view>接受量中破损 {{line.damaged}} · 尚待确认 {{line.remaining}} {{line.unit}}</view>
        <block wx:if="{{line.serials.total}}"><view>尚待确认 SN：{{line.serials.total}} 件</view>
          <view wx:for="{{line.serials.rows}}" wx:key="id" wx:for-item="sn" class="serial">{{sn.number}}</view>
          <button wx:if="{{line.serials.more}}" size="mini" data-key="{{line.serials.key}}" bindtap="moreSerials">显示更多 SN</button>
        </block>
      </view><button wx:if="{{moreLines}}" bindtap="moreLines">显示更多明细</button>
    </view>
    <view wx:if="{{formReady || pending}}" class="card receipt-form">
      <view class="heading">本次整组验收</view>
      <view class="muted">{{formMessage || pendingMessage}}</view>
      <block wx:if="{{pending}}">
        <button class="button button-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="recoverReceipt">读取原验收结果</button>
        <button wx:if="{{canSeal}}" class="button button-secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="sealReceipt">确认未执行后封存</button>
      </block>
      <block wx:if="{{formReady}}">
        <view wx:for="{{formLines}}" wx:key="id" wx:for-item="line" class="row form-line">
          <view class="heading">{{line.materialName}} · {{line.sku}}</view>
          <view>尚待确认 {{line.remaining}} {{line.unit}}</view>
          <block wx:if="{{!line.tracked}}">
            <input type="digit" data-id="{{line.id}}" data-field="accepted_qty" value="{{line.acceptedQty}}" bindinput="editFormField" placeholder="本次接受数量" />
            <input type="digit" data-id="{{line.id}}" data-field="rejected_qty" value="{{line.rejectedQty}}" bindinput="editFormField" placeholder="本次拒收数量" />
            <input type="digit" data-id="{{line.id}}" data-field="shortage_qty" value="{{line.shortageQty}}" bindinput="editFormField" placeholder="本次短少观察数量" />
            <input type="digit" data-id="{{line.id}}" data-field="damaged_qty" value="{{line.damagedQty}}" bindinput="editFormField" placeholder="接受量中破损数量" />
          </block>
          <block wx:if="{{line.tracked}}">
            <view wx:for="{{line.serials}}" wx:key="id" wx:for-item="sn" class="serial-row">
              <view>{{sn.number}} · {{sn.status || '未选择'}}{{sn.damaged ? ' · 破损' : ''}}</view>
              <button size="mini" data-line-id="{{line.id}}" data-serial-id="{{sn.id}}" bindtap="toggleSerial">循环选择接受/拒收/短少</button>
              <button size="mini" data-line-id="{{line.id}}" data-serial-id="{{sn.id}}" data-kind="material" bindtap="scanThree">扫物料码</button>
              <button size="mini" data-line-id="{{line.id}}" data-serial-id="{{sn.id}}" data-kind="serial" bindtap="scanThree">扫 SN</button>
              <button size="mini" data-line-id="{{line.id}}" data-serial-id="{{sn.id}}" data-kind="qr" bindtap="scanThree">扫二维码</button>
              <button wx:if="{{sn.status === 'accepted'}}" size="mini" data-line-id="{{line.id}}" data-serial-id="{{sn.id}}" bindtap="toggleDamaged">标记/取消破损</button>
              <view class="muted">{{sn.scanned ? '三码已记录（仅留当前页面）' : '尚未完成三码'}}</view>
            </view>
          </block>
          <view class="muted">异常类型（每项都必须填写说明并上传凭证）</view>
          <button wx:for="{{line.exceptionChoices}}" wx:key="*this" wx:for-item="type" size="mini" data-line-id="{{line.id}}" data-type="{{type}}" bindtap="addException">添加 {{type}}</button>
          <view wx:for="{{line.exceptions}}" wx:key="type" wx:for-item="exception" class="exception-editor">
            <view>{{exception.type}}</view>
            <input data-line-id="{{line.id}}" data-type="{{exception.type}}" value="{{exception.description}}" bindinput="editException" placeholder="异常说明" />
            <button size="mini" data-line-id="{{line.id}}" data-type="{{exception.type}}" data-action="select" bindtap="evidence">选择异常凭证</button>
            <view wx:if="{{exception.file}}" class="muted">凭证已完成上传并待本次提交绑定</view>
          </view>
        </view>
        <textarea value="{{formReason}}" maxlength="500" bindinput="editFormReason" placeholder="填写本次退回验收原因" />
        <button class="button button-primary" loading="{{busy}}" disabled="{{busy || scanning}}" bindtap="submitReceipt">预检并登记本次验收</button>
      </block>
    </view>
    <view class="card"><view class="heading">分批验收记录</view>
      <view wx:if="{{!batches.length}}" class="muted">尚无已确认验收记录。</view>
      <view wx:for="{{batches}}" wx:key="id" class="row"><view>{{item.number}} · {{item.status}}</view>
        <view>{{item.receivedAt}}</view><view>{{item.reason}}</view><button size="mini" data-id="{{item.id}}" bindtap="selectReceipt">查看本次验收</button>
      </view><button wx:if="{{moreBatches}}" bindtap="moreBatches">显示更多验收记录</button>
    </view>
    <view wx:if="{{selectedReceipt}}" class="card"><view class="heading">{{selectedReceipt.number}}</view>
      <view>实际验收：{{selectedReceipt.receivedAt}}</view><view class="muted">登记时间：{{selectedReceipt.recordedAt}}</view><view>{{selectedReceipt.reason}}</view>
      <view wx:for="{{selectedReceipt.lines}}" wx:key="id" wx:for-item="line" class="row">
        <view class="heading">{{line.materialName}} · {{line.sku}}</view>
        <view>接受 {{line.accepted}} · 拒收 {{line.rejected}} {{line.unit}}</view>
        <view>接受量中破损 {{line.damaged}} · 本次短少观察 {{line.shortage}} {{line.unit}}</view>
        <view wx:for="{{line.exceptions}}" wx:key="type" wx:for-item="exception" class="notice">{{exception.label}}：{{exception.description}}（已关联凭证）</view>
        <view wx:for="{{line.serials}}" wx:key="group" wx:for-item="group">
          <block wx:if="{{group.total}}"><view>{{group.label}} SN · {{group.total}} 件</view>
            <view wx:for="{{group.rows}}" wx:key="id" wx:for-item="sn" class="serial">{{sn.number}}</view>
            <button wx:if="{{group.more}}" size="mini" data-key="{{group.key}}" bindtap="moreSerials">显示更多 SN</button>
          </block>
        </view>
    </view><button wx:if="{{selectedReceipt.moreLines}}" bindtap="moreReceiptLines">显示更多本次明细</button>
      <button class="button button-primary" loading="{{inboundBusy}}" disabled="{{inboundBusy || inboundPending}}" bindtap="beginInbound">为本次已验收数量生成入账预览</button>
    </view>
    <view wx:if="{{inboundMessage || inboundPending}}" class="card receipt-form">
      <view class="heading">退回入账</view><view class="muted">{{inboundMessage}}</view>
      <block wx:if="{{inboundPending}}">
        <button class="button button-primary" loading="{{inboundBusy}}" disabled="{{inboundBusy}}" bindtap="recoverInbound">读取原入账结果</button>
        <button wx:if="{{inboundCanSeal}}" class="button button-secondary" loading="{{inboundBusy}}" disabled="{{inboundBusy}}" bindtap="sealInbound">确认未执行后封存</button>
      </block>
    </view>
    <view wx:if="{{inboundConfirming && inboundReview}}" class="card confirm-card">
      <view class="heading">{{inboundReview.title}}</view><view>{{inboundReview.description}}</view>
      <view>验收事实：{{inboundReview.receiptId}}</view><view>目标账户位置：{{inboundReview.target}}</view>
      <view wx:for="{{inboundReview.rows}}" wx:key="id" wx:for-item="row" class="row">验收明细 {{row.id}} · 入账 {{row.quantity}} · SN {{row.serialCount}} 件</view>
      <button class="button button-primary" data-confirm="true" bindtap="confirmInbound">确认入账</button>
      <button class="button button-secondary" data-confirm="false" bindtap="confirmInbound">取消</button>
    </view>
    <view wx:if="{{confirming && review}}" class="card confirm-card">
      <view class="heading">{{review.title}}</view><view>{{review.description}}</view><view>包裹：{{review.shipmentNo}}</view>
      <view>验收时刻：{{review.receivedAt}}</view><view>{{review.reason}}</view>
      <view wx:for="{{review.rows}}" wx:key="id" wx:for-item="row" class="row">{{row.sku}} · 接受 {{row.accepted}} · 拒收 {{row.rejected}} · 短少 {{row.shortage}} · 破损 {{row.damaged}}</view>
      <button class="button button-primary" data-confirm="true" bindtap="confirmSubmission">确认登记</button>
      <button class="button button-secondary" data-confirm="false" bindtap="confirmSubmission">取消</button>
    </view>
  </block>
</view>
