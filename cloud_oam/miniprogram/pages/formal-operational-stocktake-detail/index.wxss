nd:#f7fbfb}.upload-row{display:flex;flex-direction:column;gap:8rpx;padding:16rpx;border:1rpx solid #dfe7e9;border-radius:10rpx;background:#fff;overflow-wrap:anywhere}.upload-error{color:#b63422}
