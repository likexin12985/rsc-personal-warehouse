<view class="login-page">
  <view class="login-top safe-top">
    <image class="brand-mark" src="/assets/rsc-personal-warehouse-blue.png" mode="aspectFill" />
    <view class="brand-name">RSC个人仓</view>
    <view class="brand-subtitle">总部、网点与个人备件一体协同</view>
  </view>

  <view wx:if="{{checking}}" class="loading">正在检查登录状态</view>

  <view wx:else class="login-panel">
    <view wx:if="{{mode === 'sms'}}" class="field">
      <text class="field-label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入已开通账号的手机号" data-field="mobile" value="{{mobile}}" bindinput="bindField" />
    </view>

    <view wx:if="{{mode === 'sms'}}" class="field">
      <text class="field-label">短信验证码</text>
      <view class="code-row">
        <input class="input code-input" type="number" maxlength="8" placeholder="请输入验证码" data-field="code" value="{{code}}" bindinput="bindField" />
        <button class="button button-secondary code-button" disabled="{{countdown > 0}}" bindtap="requestCode">{{countdown > 0 ? countdown + '秒' : '获取验证码'}}</button>
      </view>
    </view>

    <button wx:if="{{mode === 'sms'}}" class="button button-primary login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">验证码登录</button>
    <view wx:if="{{mode === 'unavailable'}}" class="card empty">
      <text class="empty-title">当前未启用正式登录方式</text>
      <text class="empty-text">正式客户端已关闭密码和微信登录，请联系管理员启用手机验证码。</text>
    </view>
    <view class="secure-line"><text class="secure-dot"></text>仅连接发布前审核通过的 HTTPS 服务</view>
  </view>
</view>
