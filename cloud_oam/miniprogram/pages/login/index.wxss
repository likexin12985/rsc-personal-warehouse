.login-page {
  min-height: 100vh;
  padding: calc(80rpx + env(safe-area-inset-top)) 44rpx calc(44rpx + env(safe-area-inset-bottom));
  background: #f4f6f7;
}

.login-top {
  padding: 36rpx 6rpx 48rpx;
}

.brand-mark {
  width: 104rpx;
  height: 104rpx;
  border-radius: 22rpx;
}

.brand-name {
  margin-top: 30rpx;
  font-size: 52rpx;
  font-weight: 750;
}

.brand-subtitle {
  margin-top: 12rpx;
  color: #68717a;
  font-size: 25rpx;
}

.login-panel {
  padding: 36rpx;
  background: #ffffff;
  border: 1rpx solid #dfe4e7;
  border-radius: 12rpx;
}

.login-mode {
  margin-bottom: 34rpx;
}

.code-row {
  display: flex;
  gap: 14rpx;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.code-button {
  flex: 0 0 216rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}

.login-button {
  margin-top: 12rpx;
}

.wechat-login-copy {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 12rpx 0 30rpx;
}

.wechat-login-title {
  font-size: 32rpx;
  font-weight: 700;
}

.wechat-login-text {
  color: #68717a;
  font-size: 24rpx;
  line-height: 1.55;
}

.wechat-login-button {
  background: #167b45;
  color: #ffffff;
}

.secure-line {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  color: #7b858c;
  font-size: 22rpx;
}

.secure-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  background: #2d8b62;
  border-radius: 50%;
}
