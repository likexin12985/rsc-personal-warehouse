<view class="page">
  <view class="row between page-head">
    <view>
      <view class="page-title">工单物料</view>
      <view class="page-subtitle">占用、消耗、回收均关联工单，旧坏件回收后再发起退回</view>
    </view>
    <button wx:if="{{canCreate}}" class="button button-primary button-small" bindtap="createRecord">占用</button>
  </view>

  <scroll-view class="chip-row filter-row" scroll-x enhanced enable-flex show-scrollbar="false">
    <view wx:for="{{filters}}" wx:key="value" class="chip {{status === item.value ? 'chip-active' : ''}}" data-status="{{item.value}}" bindtap="setStatus">{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading">正在读取工单物料</view>
  <view wx:elif="{{!rows.length}}" class="card empty">
    <text class="empty-title">暂无工单物料记录</text>
    <text class="empty-text">投料前先登记占用，才能形成完整流向。</text>
  </view>

  <view wx:else>
    <view wx:for="{{rows}}" wx:key="id" class="list-card work-card">
      <view class="row between">
        <text class="mono order-number">{{item.workOrderNumber}}</text>
        <text class="status status-{{item.statusTone}}">{{item.statusLabel}}</text>
      </view>
      <view class="material-line">
        <view><text class="mono material-code">{{item.material.code}}</text><text class="material-name">{{item.material.name}}</text></view>
        <text class="quantity">× {{item.quantity}} {{item.material.unit}}</text>
      </view>
      <view class="work-meta">
        <text>{{item.user.name}} · {{item.warehouse.name}}</text>
        <text>{{item.conditionLabel}}<text wx:if="{{item.recoveryCondition}}"> → {{item.recoveryLabel}}</text> · {{item.createdText}}</text>
      </view>
      <view wx:if="{{item.note}}" class="note">{{item.note}}</view>
      <view wx:if="{{item.status === 'occupied'}}" class="action-grid">
        <button class="button button-secondary button-small" loading="{{actionLoading === item.id}}" disabled="{{!!actionLoading}}" data-id="{{item.id}}" catchtap="release">释放占用</button>
        <button class="button button-primary button-small" loading="{{actionLoading === item.id}}" disabled="{{!!actionLoading}}" data-id="{{item.id}}" catchtap="consume">确认消耗</button>
      </view>
      <view wx:if="{{item.status === 'consumed'}}" class="action-grid">
        <button class="button button-secondary button-small" loading="{{actionLoading === item.id}}" disabled="{{!!actionLoading}}" data-id="{{item.id}}" data-condition="old" catchtap="recover">回收旧件</button>
        <button class="button button-danger button-small" loading="{{actionLoading === item.id}}" disabled="{{!!actionLoading}}" data-id="{{item.id}}" data-condition="bad" catchtap="recover">回收坏件</button>
      </view>
    </view>
  </view>
</view>
