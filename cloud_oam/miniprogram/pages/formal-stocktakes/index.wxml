<view class="page">
  <view>
    <view class="page-title">盘点中心</view>
    <view class="page-subtitle">首次盘点、复盘、差异复核、过账和关闭保持独立状态。</view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在读取正式盘点任务</view>

  <block wx:else>
    <view class="card access-card status-{{accessAllowed ? 'success' : 'danger'}}">
      {{accessMessage}}
    </view>

    <view wx:if="{{canPrepare}}" class="card preparation-card">
      <view class="section-title">{{openingStart.enabled ? '期初盘点启动' : '期初盘点准备（只读）'}}</view>
      <view class="muted preparation-note">{{openingStart.enabled ? '添加实际盘点范围与执行人，再确认所选控制批次。服务器会重新核验。' : '仅核验范围与人员，启动功能尚未开放，不可启动。原启动结果可以独立核验。'}}</view>
      <view wx:if="{{preparation.error}}" class="status-danger preparation-note">{{preparation.error}}</view>
      <button wx:if="{{preparation.allowed}}" size="mini" bindtap="togglePreparation">{{preparation.expanded ? '收起准备目录' : '展开准备目录'}}</button>
      <block wx:if="{{preparation.allowed && preparation.expanded}}">
        <view wx:for="{{preparation.columns}}" wx:key="stage" class="preparation-column">
          <view class="field-label">{{item.label}}</view>
          <picker mode="selector" range="{{item.pickerItems}}" range-key="display" value="{{item.pickerValue}}" disabled="{{item.loading}}"
            bindchange="selectPreparation" data-stage="{{item.stage}}">
            <view class="preparation-picker">{{item.loading ? '正在核验选项' : (item.selectedName || '请选择')}}</view>
          </picker>
          <view wx:if="{{item.empty}}" class="muted preparation-note">暂无可选项，请管理员核对正式授权及保管责任；系统不自动指定人员。</view>
          <view class="preparation-actions">
            <button size="mini" disabled="{{item.loading}}" bindtap="refreshPreparation" data-stage="{{item.stage}}">刷新{{item.label}}</button>
            <button wx:if="{{item.hasMore}}" size="mini" disabled="{{item.loading}}" bindtap="morePreparation" data-stage="{{item.stage}}">加载更多</button>
          </view>
        </view>
        <view wx:if="{{preparation.summary}}" class="preparation-summary">
          <view>资产所有组织：{{preparation.summary.assetOwnerName}}</view>
          <view>库位物理归属：{{preparation.summary.physicalOwnerName}}</view>
          <view>保管责任人：{{preparation.summary.custodianName}}</view>
          <view wx:if="{{preparation.summary.assigneeName}}">本次核验人员：{{preparation.summary.assigneeName}}</view>
        </view>
        <view wx:if="{{openingStart.pending}}" class="status-danger preparation-note">本区域启动请求或恢复记录待核验，已停止新提交，请保留现有记录。</view>
        <button wx:if="{{openingStart.recoverable}}" disabled="{{openingStart.busy}}" bindtap="recoverStart">核验原启动结果</button>
        <button wx:if="{{openingStart.recoverable}}" disabled="{{openingStart.busy}}" bindtap="sealStart">终结原启动请求</button>
        <view wx:if="{{openingStart.enabled && !openingStart.pending}}">
          <view class="field-label">已发布控制批次</view>
          <picker range="{{openingStart.batches}}" range-key="display" value="{{openingStart.batchValue}}" disabled="{{openingStart.busy || openingStart.batchLoading}}" bindchange="selectStartBatch">
            <view class="preparation-picker">{{openingStart.batchLoading ? '正在核验批次' : openingStart.batches[openingStart.batchValue].display}}</view>
          </picker>
          <view class="muted preparation-note">{{openingStart.batchDescription}}</view>
          <button size="mini" disabled="{{openingStart.busy || openingStart.batchLoading}}" bindtap="refreshStartBatches">刷新控制批次</button>
          <button wx:if="{{openingStart.hasMoreBatches}}" size="mini" disabled="{{openingStart.busy || openingStart.batchLoading}}" bindtap="moreStartBatches">加载更多控制批次</button>
          <view class="field-label">新增范围的冻结方式</view>
          <picker range="{{startFreezeOptions}}" value="{{openingStart.freezeValue}}" disabled="{{openingStart.busy}}" data-field="freeze" bindchange="editStart"><view class="preparation-picker">{{startFreezeOptions[openingStart.freezeValue]}}</view></picker>
          <button disabled="{{!openingStart.canAdd}}" bindtap="addStartScope">加入盘点范围</button>
          <view wx:for="{{openingStart.scopes}}" wx:key="index"><text>{{item.label}}</text><button size="mini" disabled="{{openingStart.busy}}" data-index="{{item.index}}" bindtap="removeStartScope">移除范围</button></view>
          <view class="field-label">期初任务编号</view><input value="{{openingStart.taskNo}}" maxlength="100" disabled="{{openingStart.busy}}" data-field="taskNo" bindinput="editStart" />
          <view class="field-label">盲盘</view><switch checked="{{openingStart.blind}}" disabled="{{openingStart.busy}}" data-field="blind" bindchange="editStart" />
          <view class="field-label">截止日期（选填，所选日期 00:00）</view><picker mode="date" value="{{openingStart.deadline}}" disabled="{{openingStart.busy}}" data-field="deadline" bindchange="editStart"><view class="preparation-picker">{{openingStart.deadline || '无截止时间'}}</view></picker>
          <view class="field-label">期初盘点备注</view><textarea value="{{openingStart.note}}" maxlength="10000" disabled="{{openingStart.busy}}" data-field="note" bindinput="editStart" />
          <button disabled="{{!openingStart.canSubmit}}" bindtap="submitStart">确认范围并启动期初盘点</button>
        </view>
        <view wx:if="{{openingStart.message}}" class="preparation-note">{{openingStart.message}}</view>
        <button wx:if="{{openingStart.found}}" disabled="{{openingStart.busy}}" bindtap="openStartedTask">打开已核验任务</button>
      </block>
    </view>

    <view wx:if="{{accessAllowed && !tasks.length}}" class="empty">
      <text class="empty-title">当前没有可见盘点任务</text>
      <text class="empty-text">区域负责人尚未下发，或任务不在你的正式授权范围内。</text>
    </view>

    <view wx:for="{{tasks}}" wx:key="task_id" class="list-card task-card" bindtap="openTask" data-id="{{item.task_id}}">
      <view class="row between">
        <text class="task-no mono">{{item.task_no}}</text>
        <text class="status status-info">{{item.statusLabel}}</text>
      </view>
      <view class="divider"></view>
      <view class="task-facts">
        <view class="row between"><text class="muted">当前轮次</text><text>第 {{item.current_round_no}} 轮</text></view>
        <view class="row between"><text class="muted">范围进度</text><text>{{item.progressLabel}}</text></view>
        <view class="row between"><text class="muted">盘点方式</text><text>{{item.blind_count ? '盲盘' : '明盘'}}</text></view>
        <view class="row between"><text class="muted">截止时间</text><text>{{item.deadlineLabel}}</text></view>
      </view>
      <view class="task-actions">{{item.actionLabels}}</view>
    </view>
  </block>
</view>
