.warehouse-heading, .warehouse-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.warehouse-heading .button { flex-shrink: 0; }
.warehouse-summary { margin-top: 28rpx; padding: 28rpx; }
.warehouse-location { margin-top: 12rpx; word-break: break-all; }
.read-time, .result-count { margin-top: 20rpx; color: #76818a; font-size: 23rpx; }
.warehouse-filters { display: flex; gap: 16rpx; margin-top: 16rpx; }
.warehouse-filters picker { flex: 1; min-width: 0; }
.result-count { margin-bottom: 16rpx; }
.item-material { flex: 1; min-width: 0; }
.item-code, .item-name { display: block; word-break: break-all; }
.item-code { font-size: 23rpx; color: #68717a; }
.item-name { margin-top: 8rpx; font-weight: 650; }
.item-amount { max-width: 48%; text-align: right; overflow-wrap: anywhere; }
.item-quantity { color: #0b2a61; font-size: 34rpx; font-weight: 700; }
.warehouse-tags { display: flex; gap: 12rpx; margin: 20rpx 0; }
.item-detail { margin-top: 8rpx; color: #68717a; font-size: 23rpx; word-break: break-all; }
.warehouse-note { padding: 24rpx 0; color: #68717a; font-size: 23rpx; line-height: 1.6; }
