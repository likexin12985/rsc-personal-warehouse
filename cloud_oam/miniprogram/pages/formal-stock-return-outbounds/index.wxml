<view class="page">
  <view class="title">退回实物发出</view><view class="heading">{{number}} · {{status}}</view>
  <view class="muted">{{message}}</view>
  <button disabled="{{busy || loading}}" loading="{{loading}}" bindtap="refresh">刷新剩余实物和记录</button>
  <view wx:if="{{pendingMessage}}" class="notice"><view>{{pendingMessage}}</view>
    <button wx:if="{{pending}}" size="mini" disabled="{{busy || loading}}" bindtap="recover">读取原请求结果</button>
    <button wx:if="{{pending && canSeal}}" size="mini" disabled="{{busy || loading}}" bindtap="seal">结束未执行请求</button>
  </view>
  <view wx:if="{{feedback}}" class="notice">{{feedback}}</view>
  <view wx:if="{{ready}}" class="card"><view>接收仓：{{target}}</view><view>在途位置：{{transit}}</view>
    <view wx:if="{{cancellation}}" class="notice">原退回已取消：{{cancellation.cancelledAtLabel}} · {{cancellation.reason}}</view>
  </view>
  <view wx:if="{{ready && canSubmit && !pendingMessage}}" class="card">
    <view class="heading">选择本次实际发出的明细</view><view class="muted">同一待退回账户的库存不能在多行重复使用。SN 需重新扫描本次发出的实物。</view>
    <view wx:for="{{items}}" wx:key="operation_line_id" class="row">
      <view>{{item.material_name}} · {{item.condition}}</view><view class="muted">{{item.sku_code}} · {{item.lot_no}}</view>
      <view>原退回 {{item.return_quantity}} · 已发出 {{item.departed_quantity}} · 剩余 {{item.remaining_quantity}} {{item.base_unit}}</view>
      <view>当前可选 {{item.selectable_quantity}} {{item.base_unit}}</view>
      <button size="mini" disabled="{{busy || !item.selectable}}" data-id="{{item.operation_line_id}}" bindtap="addSource">加入本次发出</button>
    </view>
    <view wx:for="{{draftRows}}" wx:for-item="row" wx:key="id" class="row">
      <view class="heading">{{row.materialName}}</view><view class="muted">{{row.sku}} · 最多 {{row.maximum}} {{row.unit}}</view>
      <input wx:if="{{!row.tracked}}" disabled="{{busy}}" type="digit" placeholder="本次实际发出数量" value="{{row.quantity}}" data-id="{{row.id}}" bindinput="editQuantity" />
      <block wx:if="{{row.tracked}}">
        <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-code="sku_code" bindtap="scan">扫码物料号{{row.skuCaptured ? ' ✓' : ''}}</button>
        <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-code="serial_no" bindtap="scan">扫码 SN{{row.snCaptured ? ' ✓' : ''}}</button>
        <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-code="qr_code" bindtap="scan">扫码二维码{{row.qrCaptured ? ' ✓' : ''}}</button>
        <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" bindtap="collectScan">加入已扫码实物</button>
        <view wx:for="{{row.serials}}" wx:for-item="serial" wx:key="id">{{serial.number}}<button size="mini" disabled="{{busy}}" data-id="{{row.id}}" data-serial="{{serial.id}}" bindtap="removeScan">移除实物</button></view>
      </block>
      <button size="mini" disabled="{{busy}}" data-id="{{row.id}}" bindtap="removeSource">移除此行</button>
    </view>
    <view class="heading">实物实际发出时间（北京时间）</view>
    <picker mode="date" disabled="{{busy}}" value="{{date}}" bindchange="chooseDate"><view class="picker">{{date || '选择日期'}}</view></picker>
    <picker mode="time" disabled="{{busy}}" value="{{clock}}" bindchange="chooseTime"><view class="picker">{{clock || '选择时间'}}</view></picker>
    <textarea disabled="{{busy}}" value="{{reason}}" maxlength="1000" placeholder="本次发出说明" bindinput="editReason" />
    <button disabled="{{busy || !draftRows.length}}" bindtap="preview">核验本次发出</button>
    <button class="primary" disabled="{{busy || !draftRows.length}}" bindtap="submit">核验并登记实物发出</button>
  </view>
  <view wx:if="{{ready}}" class="card"><view class="heading">每批发出记录</view>
    <view wx:if="{{!history.length}}" class="muted">尚未记录实物发出。</view>
    <view wx:for="{{history}}" wx:for-item="batch" wx:key="id" class="row"><view class="heading">{{batch.number}}</view>
      <view>实物发出：{{batch.outboundAt}}</view><view class="muted">登记时间：{{batch.recordedAt}} · {{batch.reason}}</view>
      <view wx:for="{{batch.rows}}" wx:for-item="line" wx:key="id"><view>{{line.materialName}} · {{line.condition}} · {{line.quantity}} {{line.unit}}</view>
        <view wx:for="{{line.serials}}" wx:for-item="serial" wx:key="id">{{serial.number}}</view></view>
    </view>
  </view>
  <view wx:if="{{confirming}}" class="confirm-backdrop"><view class="confirm-mask" catchtouchmove="holdReview"></view><view class="confirm">
    <view class="heading">{{review.title}}</view><scroll-view scroll-y class="review-body">
      <view>{{review.workOrderNo}}</view><view class="notice">{{review.description}}</view>
      <view>接收仓：{{review.target}}</view><view>在途位置：{{review.transit}}</view><view>实际发出时间：{{review.outboundAtLabel}}</view><view>说明：{{review.reason}}</view>
      <view wx:for="{{review.rows}}" wx:key="id" wx:for-item="line" class="row"><view>{{line.materialName}} · {{line.sku}} · {{line.condition}}</view>
        <view>本次 {{line.quantity}} {{line.unit}} · {{line.lot}}</view><view class="muted">发出前本行剩余 {{line.remaining}} {{line.unit}}</view>
        <view wx:for="{{line.serials}}" wx:key="id" wx:for-item="serial">{{serial.number}}</view></view>
    </scroll-view>
    <view class="review-actions"><button class="primary" bindtap="confirmSubmission">确认以上实物已发出</button><button bindtap="cancelSubmission">暂不执行</button></view>
  </view></view>
</view>
