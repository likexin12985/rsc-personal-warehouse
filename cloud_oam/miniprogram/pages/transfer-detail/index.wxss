.header-card,
.form-card,
.logistics-card {
  padding: 26rpx;
}

.detail-number {
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  font-weight: 700;
}

.route-block {
  display: grid;
  grid-template-columns: 1fr 54rpx 1fr;
  align-items: center;
  margin-top: 26rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #e7ebed;
  border-bottom: 1rpx solid #e7ebed;
}

.route-column {
  min-width: 0;
}

.route-target {
  text-align: right;
}

.route-label,
.detail-label {
  display: block;
  margin-bottom: 6rpx;
  color: #7a858c;
  font-size: 21rpx;
}

.route-value {
  display: block;
  font-size: 25rpx;
  font-weight: 650;
}

.route-person {
  display: block;
  margin-top: 6rpx;
  color: #6f7d84;
  font-size: 21rpx;
}

.route-arrow {
  color: #e65318;
  text-align: center;
  font-size: 32rpx;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx 26rpx;
  margin-top: 24rpx;
  font-size: 23rpx;
}

.note-line {
  margin-top: 22rpx;
  padding: 16rpx;
  background: #fff5ef;
  border-radius: 8rpx;
  color: #754127;
  font-size: 23rpx;
  line-height: 1.5;
}

.item-code {
  font-size: 25rpx;
  font-weight: 700;
}

.item-quantity {
  color: #e65318;
  font-weight: 700;
}

.item-name {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.item-foot {
  margin-top: 16rpx;
}

.remark {
  max-width: 420rpx;
  color: #6c5548;
  font-size: 22rpx;
  text-align: right;
}

.compact-empty {
  padding: 44rpx 20rpx;
}

.media-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.media-tile {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 100rpx;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dfe4e7;
  border-radius: 10rpx;
}

.media-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
}

.cancel-button {
  margin-top: 16rpx;
}

.approval-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}
