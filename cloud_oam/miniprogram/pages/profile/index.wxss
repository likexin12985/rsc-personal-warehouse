.profile-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 4rpx 30rpx;
}

.profile-avatar {
  display: block;
  width: 96rpx;
  height: 96rpx;
  background: #0b2a61;
  border-radius: 20rpx;
}

.profile-name,
.profile-meta {
  display: block;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile-meta {
  margin-top: 8rpx;
  color: #6c777f;
  font-size: 23rpx;
}

.account-card {
  padding: 26rpx;
  font-size: 25rpx;
}

.menu-list {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #dfe4e7;
  border-radius: 12rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #e8ecee;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-arrow {
  color: #879198;
  font-size: 42rpx;
}

.menu-value {
  color: #637079;
  font-size: 23rpx;
}

.menu-row-disabled {
  align-items: flex-start;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.menu-note {
  display: block;
  max-width: 440rpx;
  margin-top: 8rpx;
  color: #7a858c;
  font-size: 21rpx;
  line-height: 1.5;
}

.logout-button {
  margin-top: 34rpx;
}

.personal-card {
  margin-top: 28rpx;
  padding: 26rpx;
  font-size: 25rpx;
}

.personal-card .row {
  gap: 24rpx;
}

.personal-card .row text:last-child {
  max-width: 430rpx;
  text-align: right;
}

.personal-empty {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #f6f8f9;
  border-radius: 8rpx;
  color: #6f7a82;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.personal-item {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e8ecee;
}

.personal-item-head {
  font-weight: 650;
}

.personal-item-name,
.personal-item-meta {
  display: block;
}

.personal-item-name {
  margin-top: 8rpx;
}

.personal-item-meta {
  margin-top: 8rpx;
  color: #77828a;
  font-size: 22rpx;
}

.version {
  margin-top: 28rpx;
  color: #919aa0;
  font-size: 21rpx;
  text-align: center;
}
