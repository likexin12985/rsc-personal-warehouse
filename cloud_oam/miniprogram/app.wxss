page {
  min-height: 100%;
  background: #f4f6f7;
  color: #20262c;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view, text, input, textarea, button, picker, image, video {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.page-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #68717a;
  font-size: 24rpx;
  line-height: 1.5;
}

.section {
  margin-top: 28rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 650;
}

.card {
  background: #ffffff;
  border: 1rpx solid #dfe4e7;
  border-radius: 12rpx;
}

.list-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dfe4e7;
  border-radius: 12rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.muted {
  color: #76818a;
}

.small {
  font-size: 23rpx;
}

.mono {
  font-family: "SFMono-Regular", Consolas, monospace;
  word-break: break-all;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #4c5861;
  font-size: 24rpx;
  font-weight: 600;
}

.input,
.textarea,
.picker-field {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #cfd6da;
  border-radius: 10rpx;
  color: #20262c;
  font-size: 28rpx;
}

.textarea {
  min-height: 150rpx;
  padding-top: 20rpx;
  line-height: 1.5;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.placeholder {
  color: #9aa3a9;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 30rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1;
}

.button-primary {
  background: #e65318;
  color: #ffffff;
}

.button-secondary {
  background: #ffffff;
  color: #26343c;
  border: 1rpx solid #bfc8cd;
}

.button-danger {
  background: #fff2ef;
  color: #b63422;
  border: 1rpx solid #efc1b8;
}

.button-small {
  min-height: 64rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.button[disabled] {
  opacity: 0.48;
}

.segmented {
  display: flex;
  min-height: 72rpx;
  padding: 6rpx;
  background: #e8ecee;
  border-radius: 10rpx;
}

.segment {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  border-radius: 8rpx;
  color: #59656d;
  font-size: 25rpx;
}

.segment-active {
  background: #ffffff;
  color: #20262c;
  font-weight: 650;
  box-shadow: 0 2rpx 8rpx rgba(32, 38, 44, 0.08);
}

.chip-row {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.chip {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #d4dadd;
  border-radius: 8rpx;
  color: #56626b;
  font-size: 24rpx;
}

.chip-active {
  background: #fff3ed;
  border-color: #e65318;
  color: #c94611;
  font-weight: 650;
}

.status {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 6rpx;
  font-size: 21rpx;
  font-weight: 650;
}

.status-info { background: #e7f3f5; color: #176a74; }
.status-success { background: #e8f5ee; color: #25704e; }
.status-warning { background: #fff2d9; color: #8a5b08; }
.status-danger { background: #fdebe8; color: #a23c2c; }
.status-neutral { background: #edf0f2; color: #5f6a72; }

.divider {
  height: 1rpx;
  margin: 20rpx 0;
  background: #e7ebed;
}

.empty {
  padding: 100rpx 36rpx;
  text-align: center;
  color: #7b858c;
}

.empty-title {
  display: block;
  color: #4e5961;
  font-size: 28rpx;
  font-weight: 650;
}

.empty-text {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #7b858c;
}

.sticky-action {
  position: sticky;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 8;
  margin-top: 28rpx;
  padding: 14rpx;
  background: rgba(244, 246, 247, 0.94);
}

.safe-bottom {
  height: calc(24rpx + env(safe-area-inset-bottom));
}
