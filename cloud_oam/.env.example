APP_DOMAIN=rsc.example.com
POSTGRES_DB=star_oam
# Bootstrap is a container-initialization identity only. It is never injected
# into migrate, API or backup commands after the database is initialized.
POSTGRES_USER=star_oam_bootstrap
POSTGRES_PASSWORD=replace-with-a-bootstrap-only-long-random-password
OAM_DB_MIGRATOR_PASSWORD=replace-with-a-distinct-migrator-password
OAM_DB_API_PASSWORD=replace-with-a-distinct-api-password
OAM_DB_BACKUP_PASSWORD=replace-with-a-distinct-read-only-backup-password
OAM_DATABASE_EXPECTED_RUNTIME_ROLE=star_oam_api
OAM_DATABASE_EXPECTED_MIGRATION_ROLE=star_oam_migrator
OAM_JWT_SECRET=replace-with-at-least-32-random-characters
OAM_IDENTITY_HASH_SECRET=replace-with-a-separate-32-character-random-secret
OAM_IDENTITY_HASH_VERSION=1
# Formal login/refresh/logout results are replayable for only this short window.
# The HMAC secret must be independent from JWT and identity-hash secrets. The
# KMS key ID/version are coordinates only; no plaintext AES key is accepted.
OAM_AUTH_IDEMPOTENCY_TTL_SECONDS=90
OAM_AUTH_IDEMPOTENCY_HMAC_SECRET=replace-with-an-independent-32-character-random-secret
OAM_AUTH_IDEMPOTENCY_ENCRYPTION_PROVIDER=aliyun_kms
OAM_AUTH_IDEMPOTENCY_KMS_KEY_ID=replace-with-reviewed-kms-key-id
OAM_AUTH_IDEMPOTENCY_ENCRYPTION_KEY_VERSION=1
# Formal login admission has a fourth, independent HMAC rotation boundary.
# Version changes fail closed while any previous-version bucket is still live.
OAM_AUTH_LOGIN_RATE_LIMIT_HMAC_SECRET=replace-with-a-fourth-independent-32-character-random-secret
OAM_AUTH_LOGIN_RATE_LIMIT_HASH_VERSION=1
OAM_AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
OAM_AUTH_LOGIN_RATE_LIMIT_GLOBAL_LIMIT=300
OAM_AUTH_LOGIN_RATE_LIMIT_IP_LIMIT=20
OAM_AUTH_LOGIN_RATE_LIMIT_IDENTITY_LIMIT=8
# Formal demand reads stay available with this disabled.  Enabling writes
# requires two new, mutually distinct HMAC secrets and a dedicated contact KMS
# key ID.  The API process must also install the reviewed KMS cipher adapter;
# these coordinates never provide a plaintext encryption-key fallback.
OAM_MATERIAL_REQUEST_WRITES_ENABLED=false
OAM_MATERIAL_REQUEST_IDEMPOTENCY_HMAC_SECRET=replace-with-a-fifth-independent-32-character-random-secret
OAM_MATERIAL_REQUEST_CONTACT_MOBILE_HMAC_SECRET=replace-with-a-sixth-independent-32-character-random-secret
OAM_MATERIAL_REQUEST_CONTACT_MOBILE_HASH_VERSION=1
OAM_MATERIAL_REQUEST_CONTACT_ENCRYPTION_PROVIDER=disabled
OAM_MATERIAL_REQUEST_CONTACT_KMS_KEY_ID=
# Formal non-opening stocktake commands remain disabled until the reviewed
# database runtime ACL/guards and a dedicated replay secret are deployed.
OAM_STOCKTAKE_WRITES_ENABLED=false
OAM_STOCKTAKE_IDEMPOTENCY_HMAC_SECRET=
# Formal files are disabled until a reviewed private OSS bucket, region and
# dedicated HMAC secret are supplied at deployment. OSS access credentials are
# intentionally absent: SDK V2 reads its environment credential provider.
OAM_FILE_STORAGE_ENABLED=false
OAM_FILE_STORAGE_PROVIDER=disabled
OAM_FILE_STORAGE_REGION=
OAM_FILE_STORAGE_BUCKET=
OAM_FILE_UPLOAD_INTENT_TTL_SECONDS=600
OAM_FILE_DOWNLOAD_INTENT_TTL_SECONDS=300
OAM_FILE_IDEMPOTENCY_HMAC_SECRET=
OAM_MAX_UPLOAD_BYTES=125829120
OAM_DATABASE_SCHEMA_MODE=alembic
OAM_LEGACY_PROTOTYPE_WRITES_ENABLED=false
OAM_JWT_TTL_MINUTES=15
OAM_SESSION_TTL_DAYS=30
OAM_COOKIE_SECURE=true
FORWARDED_ALLOW_IPS=127.0.0.1
# Production does not seed an administrator and never enables password login.
OAM_ADMIN_MOBILE=
OAM_ADMIN_NAME=
OAM_ADMIN_INITIAL_PASSWORD=
OAM_PASSWORD_LOGIN_ENABLED=false
# Production startup fails closed until at least one passwordless channel below
# is enabled and fully configured. Mock providers are non-production only.
OAM_SMS_LOGIN_ENABLED=false
OAM_SMS_PROVIDER=disabled
OAM_SMS_ACCESS_KEY_ID=
OAM_SMS_ACCESS_KEY_SECRET=
OAM_SMS_SIGN_NAME=
OAM_SMS_TEMPLATE_CODE=
OAM_SMS_SCHEME_NAME=RSC个人仓登录
OAM_SMS_CODE_LENGTH=6
OAM_SMS_VALID_SECONDS=300
OAM_SMS_INTERVAL_SECONDS=60
OAM_SMS_MAX_PER_MOBILE_HOUR=5
OAM_SMS_MAX_PER_IP_HOUR=20
OAM_SMS_MAX_VERIFY_ATTEMPTS=5
OAM_WECHAT_LOGIN_ENABLED=false
OAM_WECHAT_PROVIDER=disabled
OAM_WECHAT_APP_ID=
OAM_WECHAT_APP_SECRET=
# Do not put edge receiver credentials in this main API environment. Configure
# them only through deployment/edge-receiver.env.example and runtime.env.
